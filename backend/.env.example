# CORS Configuration
CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*

# Database credentials
POSTGRES_USER=hyperwrite
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hyperwrite
DATABASE_URL=postgresql+asyncpg://hyperwrite:changeme@db:5432/hyperwrite

# JWT Configuration
JWT_SECRET=change-this-secret-key-min-32-chars!!
JWT_LIFETIME=3600

# LLM Configuration (OpenAI-compatible endpoint — Ollama, llama.cpp, LM Studio, vLLM, ...)
# Examples:
#   Ollama:    http://host.docker.internal:11434/v1   (host networking) or http://localhost:11434/v1 (local dev)
#   llama.cpp: http://host.docker.internal:8080/v1
#   LM Studio: http://host.docker.internal:1234/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=local-no-key
LLM_TIMEOUT=60
